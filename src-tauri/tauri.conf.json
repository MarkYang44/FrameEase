{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameEase",
  "version": "0.1.0",
  "identifier": "com.frameease.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameEase",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPCACHE/previews/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "本地视频压缩、转码与批量处理工具",
    "longDescription": "FrameEase 在本机使用 FFmpeg 完成 H.264/HEVC/AV1 有损压缩、经逐帧校验的无损重编码、流复制封装与批量队列处理。",
    "copyright": "FrameEase contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    }
  }
}
