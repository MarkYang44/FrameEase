{
  "name": "frameease",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --config src-tauri/tauri.bundle.json",
    "windows:portable": "pwsh -NoProfile -File scripts/build-windows-portable.ps1",
    "core:test": "cargo test -p fe-core -- --test-threads=4",
    "media:gen": "bash scripts/gen-test-media.sh",
    "app:dev:bridge": "tauri dev --features dev-bridge",
    "ffmpeg:bundle": "python3 scripts/bundle_ffmpeg_macos.py"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
